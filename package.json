{
  "name": "blickfeld-nord",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:links": "node scripts/check-links.mjs",
    "a11y": "node scripts/a11y.mjs",
    "e2e": "node scripts/e2e.mjs",
    "build:site": "ng build --base-href / && node scripts/seo.mjs && node scripts/spa-fallback.mjs && node scripts/csp.mjs && node scripts/build-sw.mjs",
    "pruefen": "npm run build:site && npm run e2e && npm run a11y && npm run check:links && ng test --watch=false"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.26",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "material-icons": "^1.13.14",
    "qrcode-generator": "2.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "1.56.1",
    "@types/node": "^20.17.19",
    "axe-core": "4.11.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.28.2",
    "jsdom": "^28.0.0",
    "playwright": "1.56.1",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.9",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
